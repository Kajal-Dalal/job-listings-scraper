# ============================================================
# Job Listings Scraper - Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_KEY=your-secret-api-key-here-change-in-production

# Database
# SQLite (default for development):
DATABASE_URL=sqlite+aiosqlite:///./jobs.db
# PostgreSQL (for production):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/jobs_db

# Scraper Configuration
SCRAPE_INTERVAL_MINUTES=60
MAX_CONCURRENT_SCRAPERS=3
REQUEST_TIMEOUT_SECONDS=30
MIN_DELAY_SECONDS=2
MAX_DELAY_SECONDS=8

# Proxy Configuration (optional)
# Comma-separated list of proxy URLs
# Supports HTTP and SOCKS5
PROXY_LIST=
# Example: PROXY_LIST=http://proxy1:8080,socks5://proxy2:1080

# User Agent Configuration
UA_POOL_SIZE=50
UA_CHROME_WEIGHT=65
UA_FIREFOX_WEIGHT=20
UA_SAFARI_WEIGHT=10
UA_EDGE_WEIGHT=5

# Logging
LOG_LEVEL=INFO
# LOG_FORMAT: "json" for production, "console" for development
LOG_FORMAT=console

# Feature Flags
ENABLE_METRICS=true
ENABLE_SCHEDULER=true

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Scraper Sources (comma-separated, enable/disable)
ENABLED_SOURCES=remoteok,hn_jobs,indeed_rss

# Rate Limiting (per IP)
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# Indeed RSS Configuration
INDEED_DEFAULT_QUERY=software engineer
INDEED_DEFAULT_LOCATION=remote

# HN Jobs Configuration
HN_JOBS_MAX_RESULTS=50

# RemoteOK Configuration
REMOTEOK_MAX_RESULTS=100
